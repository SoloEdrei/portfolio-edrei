---
import { experience } from '../data/site';
---

<section id="experience" class="max-w-3xl mx-auto px-6 py-16 border-t border-slate-100">
  <div class="section-label">Experience</div>
  <div class="divider"></div>

  <div class="space-y-12">
    {experience.map((job, i) => (
      <div class={i < experience.length - 1 ? "pb-12 border-b border-slate-100" : ""}>
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-1">
          <h3 class="text-base font-semibold text-slate-800">{job.title}</h3>
          <span class="text-xs text-slate-400 shrink-0">{job.dates}</span>
        </div>
        <p class="text-sm font-medium text-teal-600 mb-4">{job.company} · {job.location}</p>

        <ul class="space-y-2 mb-4">
          {job.bullets.map((bullet) => (
            <li class="flex gap-2 text-sm text-slate-500 leading-relaxed">
              <span class="text-slate-300 mt-0.5 shrink-0">–</span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap gap-1.5">
          {job.stack.map((tech) => (
            <span class="exp-chip">{tech}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

---
import { skills } from '../data/site';
---

<section id="skills" class="max-w-3xl mx-auto px-6 py-16 border-t border-slate-100">
  <div class="section-label">Skills</div>
  <div class="divider"></div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {skills.map((group) => (
      <div class="bg-slate-50 rounded-lg p-4">
        <h3 class="text-xs font-semibold text-teal-600 uppercase tracking-wider mb-3">{group.category}</h3>
        <div class="flex flex-col gap-1">
          {group.items.map((item) => (
            <span class="text-xs text-slate-500 leading-relaxed">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

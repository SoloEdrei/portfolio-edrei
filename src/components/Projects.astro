---
import { projects } from '../data/site';
---

<section id="projects" class="max-w-3xl mx-auto px-6 py-16 border-t border-slate-100">
  <div class="section-label">Projects</div>
  <div class="divider"></div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {projects.map((project) => (
      <div class="group relative bg-white border border-slate-100 rounded-xl p-5 hover:border-teal-200 hover:shadow-sm transition-all">
        <div class="text-xs font-medium text-teal-600 mb-2">{project.tag}</div>
        <h3 class="text-sm font-semibold text-slate-800 mb-2 leading-snug">
          {project.link ? (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-teal-600 transition-colors"
            >
              {project.title}
              <svg class="inline-block ml-1 w-3 h-3 opacity-40 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ) : (
            project.title
          )}
        </h3>
        <p class="text-xs text-slate-500 leading-relaxed mb-4">{project.description}</p>
        <div class="flex flex-wrap gap-1.5">
          {project.stack.map((tech) => (
            <span class="exp-chip">{tech}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

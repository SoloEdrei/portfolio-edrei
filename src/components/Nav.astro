---
import { person } from '../data/site';
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-slate-100">
  <nav class="max-w-3xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="text-sm font-semibold text-slate-800 tracking-tight hover:text-teal-600 transition-colors">
      edrei.dev
    </a>
    <div class="hidden sm:flex items-center gap-7">
      <a href="#experience" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">Experience</a>
      <a href="#projects" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">Projects</a>
      <a href="#skills" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">Skills</a>
      <a href="#contact" class="text-sm text-slate-500 hover:text-slate-800 transition-colors">Contact</a>
    </div>
    <a
      href={person.cvUrl}
      class="text-xs font-medium px-3.5 py-1.5 rounded-md border border-slate-200 text-slate-600 hover:border-teal-400 hover:text-teal-700 transition-colors"
      target="_blank"
    >
      Download CV
    </a>
  </nav>
</header>

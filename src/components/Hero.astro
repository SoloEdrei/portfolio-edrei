---
import { person, stackHighlight } from '../data/site';
---

<section class="max-w-3xl mx-auto px-6 pt-20 pb-20">
  <div class="mb-3 flex items-center gap-2">
    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-teal-700 bg-teal-50 border border-teal-200 px-2.5 py-1 rounded-full">
      <span class="w-1.5 h-1.5 rounded-full bg-teal-500 animate-pulse"></span>
      Available for remote roles
    </span>
  </div>

  <h1 class="text-4xl font-semibold text-navy-900 leading-tight mb-2" style="color: #1B2A4A;">
    {person.name}
  </h1>

  <p class="text-lg text-teal-600 font-medium mb-4">{person.role}</p>

  <p class="text-base text-slate-500 leading-relaxed max-w-xl mb-8">
    {person.tagline}
  </p>

  <div class="flex gap-3 mb-10">
    <a
      href="#contact"
      class="text-sm font-medium px-5 py-2.5 rounded-lg text-white transition-colors"
      style="background-color: #1B2A4A;"
      onmouseover="this.style.backgroundColor='#2a3f6f'"
      onmouseout="this.style.backgroundColor='#1B2A4A'"
    >
      Contact me
    </a>
    <a
      href={person.cvUrl}
      target="_blank"
      class="text-sm font-medium px-5 py-2.5 rounded-lg border border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50 transition-colors"
    >
      Download CV
    </a>
  </div>

  <div class="flex flex-wrap gap-2">
    {stackHighlight.map((chip) => (
      <span class={chip.accent ? "chip-accent" : "chip"}>
        {chip.label}
      </span>
    ))}
  </div>
</section>
